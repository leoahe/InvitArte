# ══════════════════════════════════════════
# INVITARTE — Variables de entorno
# Copia este archivo como .env y configura tus valores
# NUNCA subas .env a GitHub
# ══════════════════════════════════════════

PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# JWT — genera uno seguro con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_STRING_LARGO_Y_ALEATORIO

# Gmail — para enviar correos de bienvenida y recuperación
# Pasos para obtener el App Password:
# 1. Ve a myaccount.google.com/security
# 2. Activa "Verificación en 2 pasos"
# 3. Ve a myaccount.google.com/apppasswords
# 4. Crea una contraseña para "Correo" / "Windows"
# 5. Pega los 16 caracteres abajo (sin espacios)
GMAIL_USER=tu.email@gmail.com
GMAIL_PASS=abcdabcdabcdabcd

# En producción cambia a:
# NODE_ENV=production
# BASE_URL=https://tu-dominio.com
